{
  "name": "com.hockeypickup.app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5174",
    "build": "yarn build-version && tsc -b && vite build",
    "lint": "eslint . --config eslint.config.cjs",
    "format": "prettier --write \"**/*.{ts,tsx}\" --config ./.prettierrc",
    "preview": "vite preview",
    "refresh-api:local": "curl --insecure --output HockeyPickup.Api.swagger.json https://localhost:7042/swagger/v1/swagger.json && npx swagger-typescript-api generate --no-client --path ./HockeyPickup.Api.swagger.json --output ./src --name HockeyPickup.Api.ts",
    "refresh-api:prod": "npx swagger-typescript-api generate --no-client --path https://api.hockeypickup.com/swagger/v1/swagger.json --output ./src --name HockeyPickup.Api.ts",
    "auth": "tsx capture-auth.ts",
    "verify:visual": "tsx verify-visual.ts",
    "goalie-backfill:preview": "tsx scripts/goalie-backfill/preview.ts",
    "goalie-backfill:generate": "tsx scripts/goalie-backfill/generate.ts",
    "goalie-backfill:check": "tsx scripts/goalie-backfill/selfcheck.ts",
    "build-version": "bash ./scripts/build-version.sh",
    "update-packages": "ncu -u",
    "check-deps": "npx depcheck"
  },
  "dependencies": {
    "@apollo/client": "^4.3.7",
    "@hello-pangea/dnd": "^18.0.1",
    "@mantine/carousel": "^9.7.5",
    "@mantine/core": "^9.7.5",
    "@mantine/dates": "^9.7.5",
    "@mantine/dropzone": "^9.7.5",
    "@mantine/form": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@mantine/modals": "^9.7.5",
    "@mantine/notifications": "^9.7.5",
    "@microlink/react-json-view": "^1.31.48",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "graphql": "^17.1.0",
    "graphql-ws": "^6.4.1",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "depcheck": "^1.4.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "mssql": "^12.7.14",
    "npm-check-updates": "^23.1.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "swagger-typescript-api": "^13.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.15.0"
  },
  "resolutions": {
    "graphql-tag": "^2.12.7"
  }
}
